{
  "name": "cc-dashboard",
  "productName": "CC-Dashboard",
  "version": "0.1.0",
  "description": "All your Claude Code sessions in one desktop window.",
  "main": "packages/app/src/main/main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "core": "node packages/core/src/index.js",
    "app": "electron .",
    "test": "node --test tests/unit/ tests/core/",
    "test:e2e": "xvfb-run -a node --test tests/e2e/",
    "dist:win": "electron-builder --win",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
